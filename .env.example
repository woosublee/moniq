# Required only for an explicitly approved Supabase environment.
# Copy to .env.local yourself; never commit real values.
# NEXT_PUBLIC_* values are public and frozen into the browser at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# No service-role key, development owner ID or demo owner ID is needed by the app.
# Access = verified auth user + active public.app_members row (role = owner).
# Login does not create accounts. Account creation/membership/owner-data transfer
# require separate approval; see docs/private-use-setup.md.
# Legacy server-env.ts getters are retained but have no active callers.
# The read-only demo uses in-memory synthetic fixtures, never a database owner.
